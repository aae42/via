#!/usr/bin/env bash
# via: expose local ports at <name>.via.stulta.dev through wstunnel
set -euo pipefail

CONFIG="${VIA_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/via/config}"
# shellcheck disable=SC1090
[ -f "$CONFIG" ] && . "$CONFIG"

VIA_DOMAIN="${VIA_DOMAIN:-via.stulta.dev}"
VIA_SERVER="${VIA_SERVER:-connect.$VIA_DOMAIN}"
VIA_RBW_ITEM="${VIA_RBW_ITEM:-via-wstunnel}"   # rbw item with base64 "cert" and "key" fields
VIA_CERT="${VIA_CERT:-}"                       # set both to use files instead of rbw
VIA_KEY="${VIA_KEY:-}"
VIA_SOCKET_DIR="${VIA_SOCKET_DIR:-/run/via}"   # path on the SERVER
VIA_WSTUNNEL="${VIA_WSTUNNEL:-wstunnel}"

adjectives=(amber brisk cobalt dusky ember fern glass hazel ivory jade keen lunar
	misty nimble opal plucky quartz rustic sandy tidy umber vivid witty zesty
	bold calm dapper eager fuzzy gentle humble jolly lucky mellow noble proud
	quiet rapid sunny tawny wild wise young)
animals=(otter heron lynx moth finch vole shrike marten badger crane drake egret
	ferret gecko hare ibis jackal koala lemur mole newt osprey panda quail raven
	seal stoat tapir urchin viper wren yak zebra bison civet dingo elk fox gull
	ibex)

random_name() {
	echo "${adjectives[RANDOM % ${#adjectives[@]}]}-${animals[RANDOM % ${#animals[@]}]}"
}

die()  { echo "via: $*" >&2; exit 1; }
warn() { echo "via: warning: $*" >&2; }

usage() {
	cat <<EOF
Usage: via [options] [NAME=][HOST:]PORT ...

Examples:
  via 3000                  random name  -> https://<adjective-animal>.$VIA_DOMAIN
  via web=3000              -> https://web.$VIA_DOMAIN
  via web=3000 api=8080     several tunnels over one connection
  via db=192.168.1.5:5432   target a different host on your LAN

Options:
  -n    dry run: print the wstunnel command and exit (doesn't touch rbw)
  -d    wstunnel debug logging
  -h    this help

Settings (env vars or $CONFIG):
  VIA_SERVER=$VIA_SERVER
  VIA_RBW_ITEM=$VIA_RBW_ITEM   (or VIA_CERT / VIA_KEY to use files)
EOF
}

dry=0; debug=0
while getopts ":ndh" opt; do
	case "$opt" in
		n) dry=1 ;;
		d) debug=1 ;;
		h) usage; exit 0 ;;
		*) usage >&2; exit 1 ;;
	esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || { usage >&2; exit 1; }

command -v "$VIA_WSTUNNEL" >/dev/null 2>&1 || die "wstunnel not found (set VIA_WSTUNNEL)"

args=()
urls=()
seen=" "
for spec in "$@"; do
	case "$spec" in
		*=*) name=${spec%%=*}; target=${spec#*=} ;;
		*)   name="";          target=$spec ;;
	esac

	case "$target" in
		*:*) host=${target%:*}; port=${target##*:} ;;
		*)   host=localhost;    port=$target ;;
	esac

	[[ $port =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] \
		|| die "bad port in '$spec'"

	if [ -z "$name" ]; then
		name="$(random_name)"
		while case "$seen" in *" $name "*) true ;; *) false ;; esac; do
			name="$(random_name)"
		done
	fi

	# same shape the server's Caddy matcher accepts, minus leading/trailing '-'
	[[ $name =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] \
		|| die "bad name '$name' (lowercase letters, digits and '-', max 63 chars)"
	case "$seen" in *" $name "*) die "name '$name' used twice" ;; esac
	seen="$seen$name "

	case "$host" in
		localhost|127.0.0.1)
			(: </dev/tcp/127.0.0.1/"$port") 2>/dev/null \
				|| warn "nothing is listening on $host:$port yet" ;;
	esac

	args+=(-R "unix://$VIA_SOCKET_DIR/$name.sock:$host:$port")
	urls+=("https://$name.$VIA_DOMAIN  ->  $host:$port")
done

fetch() { rbw get "$VIA_RBW_ITEM" --field "$1" | base64 --decode; }

cmd=("$VIA_WSTUNNEL" client)
[ "$debug" -eq 1 ] && cmd+=(--log-lvl DEBUG)

if [ "$dry" -eq 1 ]; then
	printf '%q ' "${cmd[@]}" \
		--tls-certificate "<rbw:$VIA_RBW_ITEM/cert>" \
		--tls-private-key "<rbw:$VIA_RBW_ITEM/key>" \
		"${args[@]}" "wss://$VIA_SERVER:443"
	echo
	exit 0
fi

echo "via: connecting to $VIA_SERVER"
printf '  %s\n' "${urls[@]}"
echo "  (Ctrl-C to stop)"

if [ -n "$VIA_CERT" ] && [ -n "$VIA_KEY" ]; then
	exec "${cmd[@]}" --tls-certificate "$VIA_CERT" --tls-private-key "$VIA_KEY" \
		"${args[@]}" "wss://$VIA_SERVER:443"
fi

command -v rbw >/dev/null 2>&1 || die "rbw not found (or set VIA_CERT and VIA_KEY)"
# preflight so a locked vault or wrong item name gives a clear error
# instead of wstunnel choking on an empty pipe
rbw get "$VIA_RBW_ITEM" --field cert >/dev/null || die "couldn't read '$VIA_RBW_ITEM' from rbw"

# the <(...) must stay directly on this line: bash closes the pipes if they
# are stored in a variable or array first
exec "${cmd[@]}" \
	--tls-certificate <(fetch cert) \
	--tls-private-key <(fetch key) \
	"${args[@]}" "wss://$VIA_SERVER:443"
